  [`;`], [предыдущая панель],
  [`o`], [следующая панель по кругу],
  [`q`], [показать номера; нажать номер — перейти],
  [`{` `}`], [поменять с соседней],
  [`Space`], [следующая раскладка],
  [`M-1`…`M-5`], [even-h, even-v, main-h, main-v, tiled],
