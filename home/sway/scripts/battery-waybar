#!/usr/bin/env bash

# Stands in for waybar's own battery module, which cannot show outside state:
# the same icon and percentage, plus a leaf while conservation mode (the
# IdeaPad/ThinkBook ~60% charge cap) is on. Clicking toggles that mode.
b=/sys/class/power_supply/BAT1
cons=$(cat /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode 2>/dev/null)

cap=$(cat "$b/capacity")
status=$(cat "$b/status")
icons=(󰂎 󰁺 󰁼 󰁾 󰂀 󰂂 󰁹)

if [ "$status" = Charging ]; then
    icon=󰂄
else
    # Same bucketing as waybar's own module: 7 icons over 0..100.
    icon=${icons[$((cap * 7 / 101))]}
fi

text="$icon $cap%"
tooltip="$status"
class=normal
[ "$cap" -le 20 ] && class=warning
[ "$cap" -le 10 ] && class=critical

if [ "$cons" = 1 ]; then
    text="$text <span color='#00ff00'>󰌪</span>"
    tooltip="$tooltip\\nConservation mode: charging stops at ~60%. Click to charge to 100%"
else
    tooltip="$tooltip\\nCharging to 100%. Click to cap at ~60%"
fi

printf '{"text":"%s","tooltip":"%s","class":"%s","percentage":%s}\n' \
    "$text" "$tooltip" "$class" "$cap"
